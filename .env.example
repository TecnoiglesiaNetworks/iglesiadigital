# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno — Iglesia Digital
# Copia este archivo a .env.local (local) o configúralas en Coolify (producción).
# Los valores SECRETOS van vacíos aquí: pídelos por un canal seguro. NO subir secretos a git.
# Ver DEPLOY-COOLIFY.md para el detalle del despliegue.
# ─────────────────────────────────────────────────────────────────────────────

# ── Calendly embebido en el diagnóstico (BUILD-TIME: marcar como build variable) ──
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/tecnoiglesianetwork/asesoria-iglesia-digital?hide_event_type_details=1&hide_gdpr_banner=1&text_color=000000&primary_color=ff5200"
NEXT_PUBLIC_BOOKING_URL="https://calendly.com/tecnoiglesianetwork/asesoria-iglesia-digital"

# ── Panel de administración (/admin) ──
ADMIN_USER="admin"
ADMIN_PASS=""                    # SECRETO — contraseña del primer usuario (solo siembra inicial)
SESSION_SECRET=""                # SECRETO — cadena larga aleatoria (openssl rand -hex 32)

# ── Base de datos (SQLite) ──
DB_PATH="/app/data/leads.db"     # en Coolify: montar volumen persistente en /app/data

# ── URL pública del sitio (para registrar el webhook de Calendly) ──
PUBLIC_BASE_URL="https://iglesiadigital.net"

# ── Integración Calendly (API) ──
CALENDLY_TOKEN=""                # SECRETO — Personal Access Token de Calendly
CALENDLY_WEBHOOK_SIGNING_KEY=""  # SECRETO — clave para firmar/verificar el webhook
CALENDLY_EVENT_TYPE_URI="https://api.calendly.com/event_types/b3543931-6342-41e0-bf05-128ed4fbead4"

# ── Correos (SendGrid) ──
SENDGRID_API_KEY=""              # SECRETO — API key de SendGrid
LEAD_FROM_EMAIL="hola@iglesiadigital.net"
LEAD_FROM_NAME="Iglesia Digital"
LEAD_NOTIFY_EMAIL=""             # correo donde recibir aviso de nuevos leads
